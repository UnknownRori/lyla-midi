import "umb.um"

CC           := "clang"
VERSION      := "v0.1"
OPTIMIZATION := "-O3"

// TODO  : (20261017-225235) Add Web version
fn raylib(b: ^umb::Build): ^umb::Dependency {
    src        := b.path("./external/raylib/src")
    cflags     := []str{"-O2"}
    deps       := []^umb::Dependency{}
    linker_arg := []str{}

    cflags     = append(cflags, "-DSUPPORT_FILEFORMAT_FLAC")
    if b.os == "windows" {
        linker_arg = append(linker_arg, "-lwinmm")
        linker_arg = append(linker_arg, "-lgdi32")
        linker_arg = append(linker_arg, "-lopengl32")
        cflags     = append(cflags, "-DPLATFORM_DESKTOP")
    } else {
        cflags     = append(cflags, "-DPLATFORM_DESKTOP")
        cflags     = append(cflags, "-fPIC")
        cflags     = append(cflags, "-D_GLFW_X11")
        deps       = append(deps, b.dependency("m"))
        deps       = append(deps, b.dependency("x11"))
        deps       = append(deps, b.dependency("xext"))
        deps       = append(deps, b.dependency("xrandr"))
        deps       = append(deps, b.dependency("xcursor"))
        deps       = append(deps, b.dependency("xfixes"))
        deps       = append(deps, b.dependency("threads"))
    }

    lib := b.createLibrary({
        name    : "raylib",
        cc      : CC,
        cflags  : cflags,
        linker  : linker_arg,
        deps    : deps,
        sources : []str{
            src.path("raudio.c"),
            src.path("rcore.c"),
            src.path("rmodels.c"),
            src.path("rshapes.c"),
            src.path("rtext.c"),
            src.path("rtextures.c"),
            src.path("rglfw.c"),
        },
        include_directories: []str{src.path("."), src.path("./external/glfw/include")},
    })

    return b.declareDependency({
        name      : "raylib",
        link_with : []^umb::Library{lib},
        cflags    : cflags,
        linker    : linker_arg,
        deps      : deps,
        include_directories : []str{src.path(".")},
    })
}

fn build(b: ^umb::Build) {
    raylib   := raylib(b)
    src      := b.path("./src")
    external := b.path("./external")
    hash := b.capture("git rev-parse --short HEAD", "unknown") 

    version_c := b.generate("version.c",
        "const char* const VERSION = \"" + VERSION + "\";\n\nconst char* const GIT_HASH = \"" + hash + "\";\n"
    )
    b.generate("version.h",
        "#pragma once\nextern const char* const VERSION;\nextern const char* const GIT_HASH;\n#define GIT_HASH_STR \"" + hash + "\"\n"
    )

    exe := b.createExecutable({
        name    : "lyla-midi",
        cc      : CC,
        cflags  : []str{"-Wall", "-Wextra", OPTIMIZATION},
        deps    : []^umb::Dependency{raylib},
        sources : []str{
            src.path("main.c"),
            src.path("text.c"),
            src.path("lyla.c"),
            src.path("config.c"),
            src.path("record.c"),
            src.path("thirdparty/rmidi.c"),
            src.path("ui/music_profile.c"),
            src.path("ui/background.c"),
            src.path("ui/midi_visualizer.c"),
            src.path("ui/music_info.c"),
            src.path("ui/chord_info.c"),
            src.path("ui/beat.c"),
            src.path("visualizer/fft.c"),
            src.path("visualizer/visualizer.c"),
            external.path("config.c/src/rconfig.c"),
            version_c,
        },
        include_directories: []str{
            src.path("."),
            external.path("rstb"),
            external.path("rmidi"),
            external.path("config.c/src"),
            b.genDir(),
        }
    })

    build := b.step("build", "Build the thing")
    build.dependsOn(exe)

    run := b.step("run", "Run the thing")
    run.dependsOn(exe)
    run.addCommand(exe.output())
}
